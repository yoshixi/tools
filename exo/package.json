{
  "name": "exo",
  "version": "0.1.0",
  "private": true,
  "description": "Local Excalidraw editor — open .excalidraw files in the browser",
  "type": "module",
  "bin": {
    "exo": "./bin/exo.mjs"
  },
  "scripts": {
    "build": "pnpm build:web && pnpm build:cli",
    "build:web": "vite build",
    "build:cli": "tsc -p tsconfig.json",
    "dev": "pnpm build && node dist/cli.js --foreground",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "pnpm build:cli && node --test 'dist/**/*.test.js'",
    "test:e2e": "pnpm build && node test/e2e.mjs",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "chokidar": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
