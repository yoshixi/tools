{
  "name": "@yoshixi/exo",
  "version": "0.1.0",
  "description": "Local Excalidraw editor — open .excalidraw files in the browser",
  "type": "module",
  "bin": {
    "exo": "./bin/exo.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && pnpm build:web && pnpm build:cli",
    "build:web": "vite build",
    "build:cli": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "dev": "pnpm build && node dist/cli.js start --foreground",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "pnpm build:test && node --test 'dist/**/*.test.js'",
    "test:e2e": "pnpm build && node test/e2e.mjs",
    "prepublishOnly": "pnpm build",
    "start": "node dist/cli.js start"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.10.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshixi/tools.git",
    "directory": "exo"
  },
  "homepage": "https://github.com/yoshixi/tools/tree/main/exo",
  "bugs": {
    "url": "https://github.com/yoshixi/tools/issues"
  },
  "keywords": [
    "excalidraw",
    "cli",
    "diagram",
    "local"
  ],
  "license": "MIT",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@moona3k/excalidraw-export": "^0.2.1",
    "chokidar": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
