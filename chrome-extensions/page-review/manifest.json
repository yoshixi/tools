{
  "manifest_version": 3,
  "name": "Page Review",
  "version": "0.1.0",
  "description": "Review any web page like a pull request. Leave comments on text, then copy them as a prompt for an AI agent.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Page Review: toggle comment mode" },
  "commands": {
    "toggle-comment-mode": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" },
      "description": "Toggle comment mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
